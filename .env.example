# ARGUS configuration — generated by `python -m core.config --write-env-example`.
# Every variable ARGUS reads is listed here; see core/config.py for details.
# Copy to .env and fill in at least one generation provider's key.

# --- API credentials — at least one generation provider is required ---
# Gemini key (planner, codegen, vision scoring). GOOGLE_API_KEY_2..._10 are also read and round-robined as a pool.
GOOGLE_API_KEY=
# DeepSeek key (codegen fallback).
DEEPSEEK_API_KEY=
# Groq key (fast codegen fallback).
GROQ_API_KEY=
# Second Groq key for the pool.
GROQ_API_KEY_2=
# OpenRouter key (last-resort codegen).
OPENROUTER_API_KEY=
# Second OpenRouter key for the pool.
OPENROUTER_API_KEY_2=
# HuggingFace key (reference-image generation).
HF_API_KEY=
# NVIDIA NIM key (reference images).
NVIDIA_API_KEY=
# Alias for NVIDIA_API_KEY.
NVIDIA_NIM_API_KEY=
# Cloudflare Workers AI account (reference images).
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare Workers AI token.
CLOUDFLARE_API_TOKEN=

# --- Blender ---
# Path to the Blender executable, or just 'blender' if it's on PATH.
BLENDER_PATH=blender
# Seconds a single Blender build may run before it's killed.
BLENDER_EXEC_TIMEOUT=300
# Seconds a headless MCP topology-analysis pass may run.
BLENDER_MCP_TIMEOUT=120

# --- Pipeline shape ---
# Root directory for runs/ and final/. Read at import time, so one process per output root (this is why eval/runner.py uses subprocesses).
ARGUS_OUTPUT_ROOT=out
# Legacy alias for ARGUS_OUTPUT_ROOT, still honoured.
ARGUS_OUT_ROOT=
# 1 = skip the expensive quality passes.
ARGUS_FAST=0
# Seed for the compiler's deterministic jitter/greebles.
ARGUS_SEED=42
# Hard wall-clock budget for one run; 0 = unlimited.
ARGUS_MAX_SECONDS=0
# 1 = use the deterministic scene-graph compiler; 0 = LLM codegen only.
ARGUS_COMPILER=1
# 1 = run the topology validation pass.
ARGUS_VALIDATE=1
# 1 = keep intermediate per-iteration artifacts.
ARGUS_KEEP_HISTORY=0
# 1 = save qualifying builds to structure memory without asking.
ARGUS_AUTO_APPROVE_MEMORY=0
# Score at or above which a build is audited.
ARGUS_AUDIT_THRESHOLD=7

# --- Quality loop ---
# Visual score the repair loop aims for.
ARGUS_VISUAL_TARGET=7
# Max visual-improvement iterations.
ARGUS_VISUAL_ITERS=5
# Max full-regeneration attempts.
ARGUS_OUTER_REGEN=3
# Best-of-N candidate builds.
ARGUS_INITIAL_CANDIDATES=3
# Score that ends best-of-N early. Defaults to ARGUS_VISUAL_TARGET + 1.
ARGUS_BESTN_EARLY_EXIT=
# Parallel plan candidates scored before building.
ARGUS_SPEC_CANDIDATES=3
# Cap on the effective score's texture bonus, in score points.
ARGUS_TEXTURE_WORTH=2
# DEAD: read here but never used; the live cap is MAX_REPAIR_ATTEMPTS in core/prompt.py. Registered so the discrepancy is documented, not hidden.
ARGUS_MAX_REPAIRS=4
# 1 = use the checklist critic when scoring.
ARGUS_CHECKLIST=1
# Critic votes per review round.
ARGUS_CRITIC_VOTES=1
# 1 = two-stage (brief then plan) planning.
ARGUS_TWO_STAGE=1
# 1 = score against a multi-view render grid.
ARGUS_MULTIVIEW_REF=1

# --- Geometry and finishing ---
# 1 = enforce the poly budget on the exported GLB (planar dissolve, then collapse to the _POLY_TARGETS ceiling). The .blend keeps full detail. Set 0 to restore the old advisory-only behaviour, where the budget was a prompt request nothing verified and output ran up to 56x over.
ARGUS_POLY_ENFORCE=1
# 1 = apply the bevel/weighted-normals pass.
ARGUS_BEVEL=1
# 1 = add compiler surface detail.
ARGUS_GREEBLES=1
# 1 = apply deterministic imperfection jitter.
ARGUS_JITTER=1
# 1 = auto-rig articulated parts.
ARGUS_RIG=1
# 1 = export additional LOD meshes.
ARGUS_LODS=0
# 1 = bake procedural materials to textures.
ARGUS_BAKE=1
# 1 = bake ambient occlusion.
ARGUS_AO_BAKE=1
# Bake texture resolution in pixels.
ARGUS_BAKE_RES=512

# --- Texturing ---
# 1 = run the diffusion texture-paint pass.
ARGUS_PAINT=1
# Paint pass resolution in pixels.
ARGUS_PAINT_RES=1024
# Brightness multiplier for painted textures.
ARGUS_PAINT_BRIGHT=1.4
# Poly Haven texture resolution to fetch.
ARGUS_PH_RESOLUTION=1k
# Seconds to wait for the Poly Haven catalog.
ARGUS_PH_FETCH_TIMEOUT=10
# Seconds to wait for a texture download.
ARGUS_PH_DOWNLOAD_TIMEOUT=30
# 1 = allow Gemini image models for references.
ARGUS_GEMINI_IMAGES=0
# Comma-separated reference-image provider order; defaults to the built-in order.
ARGUS_IMAGE_PROVIDERS=

# --- LLM transport ---
# Attempts per provider before falling through.
ARGUS_LLM_MAX_RETRIES=3
# Cooldown seconds applied to a rate-limited key (times two). Despite the name this is a flat cooldown, not an exponential backoff base.
ARGUS_LLM_BACKOFF=2.0
# Per-request Gemini timeout in seconds.
ARGUS_GEMINI_TIMEOUT=90
# Wall-clock cap for a Gemini codegen call.
ARGUS_GEMINI_CODE_TIMEOUT=240
# Per-request OpenRouter/Groq timeout in seconds.
ARGUS_OR_TIMEOUT=180
# 1 = include gemini-2.5-pro in the model list.
ARGUS_USE_GEMINI_PRO=0

# --- Live Blender (MCP) — opt-in, executes code in a running Blender ---
# Bind address for the live-Blender exec server. Changing this off loopback exposes an code-execution endpoint; don't.
ARGUS_MCP_HOST=127.0.0.1
# Port for the live-Blender exec server.
ARGUS_MCP_PORT=9876
# Seconds to wait on a live-MCP response.
ARGUS_MCP_TIMEOUT=180
# 1 = auto-launch a GUI Blender if none is listening.
ARGUS_MCP_AUTOLAUNCH=1
# Shared secret required by the live exec server. Generated per launch when unset; only set it manually to attach to an existing server.
ARGUS_MCP_TOKEN=
# Legacy alias for ARGUS_MCP_HOST.
BLENDER_HOST=

# --- Desktop service ---
# Bearer token the desktop UI must send. Generated per launch by run_app.bat and inherited by both processes.
ARGUS_API_TOKEN=
# Comma-separated extra CORS origins, for serving the UI from somewhere other than the desktop shell (e.g. https://argus.pages.dev). The localhost and tauri:// origins are always allowed. An explicit list rather than '*': a tunnelled backend is reachable from anywhere.
ARGUS_ALLOWED_ORIGINS=
# Queue backend for the optional worker (service/worker.py).
REDIS_URL=redis://localhost:6379/0

# --- Remote storage (optional) ---
# Bucket for uploading finished assets. Empty = local only.
ARGUS_S3_BUCKET=
# S3-compatible endpoint URL.
ARGUS_S3_ENDPOINT_URL=
# S3 region.
ARGUS_S3_REGION=auto
# S3 access key id.
ARGUS_S3_ACCESS_KEY_ID=
# S3 secret access key.
ARGUS_S3_SECRET_ACCESS_KEY=
# Public base URL prefix for uploaded assets.
ARGUS_S3_PUBLIC_BASE_URL=
# Presigned URL lifetime in seconds.
ARGUS_S3_PRESIGN_EXPIRES=604800
